# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 运行时数据（会话、图库、模板注册表）——启动时自动重建
data/

# 局域网自签 HTTPS 证书（含私钥，绝不入库）
certs/

# 导入 schema 前的自动备份
*.bak

# 临时产物
.tmpcheck/

# 个人模板数据（工作流 + 面板定义）不入库——
# 只保留一个示例模板（amiya）+ 规则注册表（引擎配套）
templates/*
!templates/amiya.json
schemas/*
!schemas/amiya.json
!schemas/_rules.json
